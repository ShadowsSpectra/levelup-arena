{
  "name": "levelup-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner && vite build --config vite.server.config.ts --configLoader runner",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
